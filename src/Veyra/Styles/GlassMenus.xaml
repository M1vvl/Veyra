<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:GlassDock.Styles">
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContextMenu}">
      <local:GlassMenuSurface Margin="7"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></local:GlassMenuSurface>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="7,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type MenuItem}">
      <Grid>
        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" MinHeight="32">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" VerticalAlignment="Center"/>
            <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" Width="16"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Opacity=".6" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="-3" VerticalOffset="-7" PopupAnimation="None">
          <local:GlassMenuSurface Margin="7"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></local:GlassMenuSurface>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#32E6F3FF"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".42"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Margin="25,5,8,5" Background="#28DAE9F5"/></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
